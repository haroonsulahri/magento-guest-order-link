<?php
/** @var \Haroone\LinkGuestOrderToCustomer\Block\Adminhtml\Order\Confirm $block */
/** @var \Magento\Framework\Escaper $escaper */

$order = $block->getOrder();
$customer = $block->getCustomer();
?>
<section class="admin__page-section">
    <div class="admin__page-section-title">
        <span class="title"><?= $escaper->escapeHtml(__('Confirm Link to Customer Account')) ?></span>
    </div>
    <div class="admin__page-section-content">
        <p>
            <?= $escaper->escapeHtml(
                __('Review the guest order and matched customer account. This action permanently assigns the order to this customer account.')
            ) ?>
        </p>

        <table class="admin__table-secondary">
            <tbody>
                <tr>
                    <th><?= $escaper->escapeHtml(__('Order')) ?></th>
                    <td>#<?= $escaper->escapeHtml((string)$order->getIncrementId()) ?></td>
                </tr>
                <tr>
                    <th><?= $escaper->escapeHtml(__('Order Email')) ?></th>
                    <td><?= $escaper->escapeHtml((string)$order->getCustomerEmail()) ?></td>
                </tr>
                <tr>
                    <th><?= $escaper->escapeHtml(__('Customer Name')) ?></th>
                    <td><?= $escaper->escapeHtml($block->getCustomerName()) ?></td>
                </tr>
                <tr>
                    <th><?= $escaper->escapeHtml(__('Customer Email')) ?></th>
                    <td><?= $escaper->escapeHtml((string)$customer->getEmail()) ?></td>
                </tr>
            </tbody>
        </table>
    </div>
</section>

<div class="message message-warning warning">
    <div>
        <?= $escaper->escapeHtml(
            __(
                'This action links the order to the customer account. It does not change the order status, totals, payment, addresses, quote data, or storefront visibility settings.'
            )
        ) ?>
    </div>
</div>

<?php if (!$block->isOrderStatusVisibleOnFront()): ?>
    <div class="message message-warning warning">
        <div>
            <?= $escaper->escapeHtml(
                __(
                    'The current order status is not visible on the storefront. Linking can still succeed, but the order will remain hidden from the customer\'s order history until the global order-status configuration is updated.'
                )
            ) ?>
        </div>
    </div>
<?php endif; ?>

<form method="post" action="<?= $escaper->escapeUrl($block->getLinkUrl()) ?>">
    <input type="hidden"
           name="form_key"
           value="<?= $escaper->escapeHtmlAttr($block->getFormKey()) ?>"/>
    <input type="hidden"
           name="order_id"
           value="<?= $escaper->escapeHtmlAttr((string)$order->getEntityId()) ?>"/>
    <button type="submit" class="action-primary scalable">
        <span><?= $escaper->escapeHtml(__('Link to Customer Account')) ?></span>
    </button>
    <a class="action-secondary" href="<?= $escaper->escapeUrl($block->getBackUrl()) ?>">
        <span><?= $escaper->escapeHtml(__('Cancel')) ?></span>
    </a>
</form>
